package com.secret.santa.service;

import com.secret.santa.model.SantaAssignment;
import com.secret.santa.model.Employee;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.csv.CSVFormat;
import org.apache.commons.csv.CSVParser;
import org.apache.commons.csv.CSVPrinter;
import org.apache.commons.csv.CSVRecord;
import org.springframework.stereotype.Service;

import java.io.BufferedWriter;
import java.io.File;
import java.io.IOException;
import java.io.Reader;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Service
@Slf4j
public  class CsvService {

    public static List<Employee> readEmployees(String filePath) throws IOException {
        List<Employee> employees = new ArrayList<>();
        try (Reader reader = Files.newBufferedReader(Paths.get(filePath));
             CSVParser csvParser = new CSVParser(reader, CSVFormat.DEFAULT.withFirstRecordAsHeader())) {

            for (CSVRecord employeeRecord : csvParser) {
                employees.add(new Employee(employeeRecord.get("Employee_Name"), employeeRecord.get("Employee_EmailID")));
            }
        }
        return employees;
    }

    public static Map<String, String> readPreviousAssignments(String filePath) {
        Map<String, String> previousAssignments = new HashMap<>();

        File file = new File(filePath);
        if (!file.exists()) {
            log.info("⚠️ Warning: Previous year assignments file not found. Proceeding without constraints.");
            return previousAssignments;  // Return empty map if the file doesn't exist
        }

        try (Reader reader = Files.newBufferedReader(Paths.get(filePath));
             CSVParser csvParser = new CSVParser(reader, CSVFormat.DEFAULT.withFirstRecordAsHeader())) {

            for (CSVRecord record : csvParser) {
                previousAssignments.put(record.get("Employee_EmailID"), record.get("Secret_Child_EmailID"));
            }
        } catch (IOException e) {
            log.info("❌ Error reading previous assignments file: {}", e.getMessage());
        }

        return previousAssignments;
    }

    public static void writeAssignments(String filePath, List<SantaAssignment> santaAssignments) throws IOException {
        try (BufferedWriter writer = Files.newBufferedWriter(Paths.get(filePath));
             CSVPrinter csvPrinter = new CSVPrinter(writer, CSVFormat.DEFAULT.withHeader(
                     "Employee_Name", "Employee_EmailID", "Secret_Child_Name", "Secret_Child_EmailID"))) {

            for (SantaAssignment santaAssignment : santaAssignments) {
                csvPrinter.printRecord(
                        santaAssignment.getGiver().getEmployeeName(),
                        santaAssignment.getGiver().getEmployeeEmailId(),
                        santaAssignment.getReceiver().getEmployeeName(),
                        santaAssignment.getReceiver().getEmployeeEmailId()
                );
            }
        }
    }


}
